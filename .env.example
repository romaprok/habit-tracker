POSTGRES_USER=habit
POSTGRES_PASSWORD=habit
POSTGRES_DB=habit_tracker
POSTGRES_PORT=5433
DATABASE_URL=postgresql://habit:habit@localhost:5433/habit_tracker

PORT=3000
TEST_DATABASE_URL=postgresql://habit:habit@localhost:5433/habit_tracker_test

NODE_ENV=development
# Dev-only value. For production generate one: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Access token lifetime in seconds (default 900 = 15 min). Try 30 to see the silent refresh.
# ACCESS_TOKEN_TTL_SECONDS=30

# Origins allowed to send POST/PUT/PATCH/DELETE (CSRF check), comma-separated
ALLOWED_ORIGINS=http://localhost:5173

# GitHub OAuth App: https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
# (the callback goes through the Vite proxy, so cookies stay on one origin).
# Put the real values only in .env, never in git. Leave both empty to skip.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
